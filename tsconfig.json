{
	"compilerOptions": {
		"strict": true,
		"target": "ESNext",
		"module": "ESNext",
		"allowJs": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"noImplicitAny": true,
		"sourceMap": true,
		"outDir": "dist",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strictNullChecks": true,
		"paths": {
			"@main/*": ["./main/*"],
			"@renderer/*": ["./renderer/*"],
			"@shared/*": ["./shared/*"]
		},
		"resolveJsonModule": true
	},
	"include": ["renderer/*.tsx", "renderer/*.ts", "main/*.ts", "shared/*.ts"]
}
